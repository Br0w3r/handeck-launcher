{
  "name": "handeck-launcher",
  "version": "0.1.0",
  "description": "Launcher de juegos tipo PS5 para handhelds Windows (MSI Claw, ROG Ally, Legion Go)",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "detect": "tsx scripts/testDetection.ts",
    "icon": "node scripts/gen-icon.mjs",
    "fetch:legendary": "node scripts/fetch-legendary.mjs",
    "dist": "npm run fetch:legendary && electron-vite build && electron-builder --win --config electron-builder.config.js",
    "dist:dir": "npm run fetch:legendary && electron-vite build && electron-builder --win --dir --config electron-builder.config.js"
  },
  "dependencies": {
    "@node-steam/vdf": "^2.2.0",
    "axios": "^1.7.0",
    "electron-store": "^8.2.0",
    "ps-list": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
